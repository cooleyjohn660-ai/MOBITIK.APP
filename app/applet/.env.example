# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# Mobitik Treasury Wallet Configuration for Automated USDT Payouts on BNB Smart Chain
# Public address of the Mobitik Treasury Wallet holding BEP-20 USDT and BNB for gas
TREASURY_WALLET_ADDRESS=0x71C809187313c49F86236b2848F2F87D38D33989

# Secure Private Key or Relayer Secret for automated transaction signing
# Leave empty to keep withdrawals in safety queue until key/relayer is configured
TREASURY_PRIVATE_KEY=

# Secure Backend Relayer Webhook (Alternative to direct key, recommended for production)
AUTO_PAYOUT_RELAYER_URL=

# BSC JSON-RPC URL (Defaults to Binance official high-performance public RPCs)
BSC_RPC_URL=https://bsc-dataseed.binance.org/

# Verified Official USDT Contract on BNB Smart Chain (BEP-20)
# Mainnet: 0x55d398326f99059fF775485246999027B3197955
# Testnet (Chapel): 0x337610d27c682E347C9cD60BD4b3b107C9d34dDd
BSC_USDT_CONTRACT_ADDRESS=0x55d398326f99059fF775485246999027B3197955

# Set to "true" when testing on BSC Testnet (Chapel, Chain ID 97)
BSC_IS_TESTNET=false
